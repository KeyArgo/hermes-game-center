[Unit]
Description=Game Center Online (games.hermesnet.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gameshelf
Group=gameshelf
WorkingDirectory=/opt/gameshelf-online/app
ExecStart=/opt/gameshelf-online/venv/bin/python -m online.server --data /var/lib/gameshelf-online --host 127.0.0.1 --port 8790 --trust-proxy
Restart=on-failure
RestartSec=3
# A small turn-based server; these caps keep it from crowding Synchronet on a 2 GB box.
MemoryMax=300M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gameshelf-online
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
